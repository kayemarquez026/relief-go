{
  "name": "relief-go",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint .",
    "dev:server": "npm run dev --workspace=reliefgo-api",
    "dev:full": "node server/scripts/dev.mjs",
    "db:migrate": "npm run db:migrate --workspace=reliefgo-api",
    "admin": "npm run admin --workspace=reliefgo-api",
    "test:api": "npm run test --workspace=reliefgo-api",
    "check:source": "node server/scripts/preflight.mjs && node server/scripts/static-check.mjs && python server/scripts/check-template.py",
    "db:check": "npm run db:check --workspace=reliefgo-api"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "chart.js": "^4.5.1",
    "ionicons": "^8.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/google.maps": "^3.66.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "cypress": "^13.5.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "~4.0.18",
    "vue-tsc": "^2.1.10"
  },
  "description": "ReliefGO original Ionic Vue design with PostgreSQL API, proof review and volunteer flows",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=22"
  }
}
