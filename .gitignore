# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
.env
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Local database exports and secret environments
*.dump
*.backup
*.sql.gz
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Android local and generated files
android/.gradle/
android/**/build/
android/local.properties
android/.cxx/
android/captures/

# Android signing keys
*.keystore
*.jks
*.p12
*.pem