# For Supabase: replace DATABASE_URL with the URI from Supabase Dashboard > Connect
# Use the SESSION POOLER (IPv4 compatible, port 5432) for the current migration runner.
# Keep SSL enabled (include ?sslmode=require or the supplied Supabase connection URI).
# Never set VITE_DATABASE_URL or place a database password in a VITE_ variable.
# POSTGRES_PASSWORD is ONLY for the optional local Docker service.

# Ionic Vue browser development proxies /api to the Express backend
VITE_API_BASE_URL=/api
# For Capacitor devices use a deployed HTTPS URL instead of /api
# VITE_API_BASE_URL=https://your-backend.example/api

# Optional: replace the demo Photon geocoding endpoint with your deployed Photon-compatible service.
# Search and GPS reverse-geocoding need internet. No API key is required for demo testing.
# VITE_GEOCODING_BASE_URL=https://your-geocoding-service.example
